@if (!hasData)
{
    <!-- TRYB 1: PUSTY FORMULARZ -->
    <RadzenCard Variant="Variant.Filled" Class="rz-p-4">
        <RadzenText TextStyle="TextStyle.H6" Class="rz-color-primary rz-font-weight-bold rz-mb-3">Uzupełnij dane sprzedawcy</RadzenText>
        <RadzenDivider Class="rz-mb-4" />

        <RadzenStack Gap="1.25rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Pełna nazwa firmy</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_Nazwa" Style="width: 100%;" Placeholder="np. Podhale Tech Sp. z o.o." />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">NIP</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_NIP" Style="width: 100%;" Placeholder="10 cyfr NIP" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Ulica</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_Ulica" Style="width: 100%;" Placeholder="np. ul. Środkowa" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Nr budynku / lokalu</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_UlicaNr" Style="width: 100%;" Placeholder="12A/4" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Numer BDO</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_Numer_BDO" Style="width: 100%;" Placeholder="Opcjonalnie" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Kod pocztowy</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_KodPocztowy" Style="width: 100%;" Placeholder="np. 34-405" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Miejscowość</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_Miejscowosc" Style="width: 100%;" Placeholder="np. Białka Tatrzańska" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-color-primary rz-font-weight-bold rz-mt-3 rz-mb-1">Bank i domyślne parametry dokumentów</RadzenText>
            <RadzenDivider Class="rz-mb-2" />

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Nazwa banku</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_BankNazwa" Style="width: 100%;" Placeholder="np. PKO Bank Polski" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Numer konta IBAN</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Sprzedawca_BankKonto" Style="width: 100%;" Placeholder="26 cyfr rachunku" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Domyślne miejsce wystawienia</RadzenText>
                    <RadzenTextBox @bind-Value="@model.Faktura_MiejsceWystawienia" Style="width: 100%;" Placeholder="np. Białka Tatrzańska" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Class="rz-mt-3">
                <RadzenButton Text="Zapisz dane firmy" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveData" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
}
