<RadzenCard Variant="Variant.Filled" Class="rz-p-4 rz-mb-4">
    <RadzenRow AlignItems="AlignItems.Center" RowGap="2">
        <RadzenColumn Size="12" SizeMD="5">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenIcon Icon="analytics" Class="rz-color-primary" Style="font-size: 1.8rem;" />
                <div>
                    <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0 rz-font-weight-bold">
                        Podsumowanie sprzedaży
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-m-0">
                        Okres: <strong class="rz-color-primary">@selectedPeriodLabel</strong>
                    </RadzenText>
                </div>
            </RadzenStack>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="7">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenDropDown TValue="string"
                                Value="@selectedPeriodType"
                                ValueChanged="@OnPeriodTypeChanged"
                                Data="@periodTypes"
                                Style="min-width: 120px;" />

                @if (selectedPeriodType == "Miesiąc")
                {
                    <RadzenDropDown TValue="string"
                                    Value="@selectedMonth"
                                    ValueChanged="@OnMonthChanged"
                                    Data="@monthsList"
                                    Style="min-width: 140px;" />
                }
                else if (selectedPeriodType == "Kwartał")
                {
                    <RadzenDropDown TValue="string"
                                    Value="@selectedQuarter"
                                    ValueChanged="@OnQuarterChanged"
                                    Data="@quartersList"
                                    Style="min-width: 140px;" />
                }

                <RadzenDropDown TValue="string"
                                Value="@selectedYear"
                                ValueChanged="@OnYearChanged"
                                Data="@yearsList"
                                Style="min-width: 100px;" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

<!-- SPÓJNE FISZKI KPI -->
<RadzenRow Gap="1rem" Class="rz-mb-4">
    <!-- 1. SPRZEDAŻ BRUTTO -->
    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
        <RadzenCard Variant="Variant.Filled" Class="rz-p-3" Style="border-left: 4px solid var(--rz-primary);">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-m-0">Suma sprzedaży brutto</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" Class="rz-m-0 rz-font-weight-bold">@FormatPLN(summaryData.TotalSales)</RadzenText>
                </RadzenStack>
                <RadzenIcon Icon="payments" Class="rz-color-primary" Style="font-size: 2rem;" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <!-- 2. NALICZONY VAT -->
    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
        <RadzenCard Variant="Variant.Filled" Class="rz-p-3" Style="border-left: 4px solid var(--rz-info);">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-m-0">Podatek VAT</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" Class="rz-m-0 rz-font-weight-bold">@FormatPLN(summaryData.TotalSales * 0.23m / 1.23m)</RadzenText>
                </RadzenStack>
                <RadzenIcon Icon="account_balance" Class="rz-color-info" Style="font-size: 2rem;" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <!-- 3. DOKUMENTY SPRZEDAŻY -->
    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
        <RadzenCard Variant="Variant.Filled" Class="rz-p-3" Style="border-left: 4px solid var(--rz-success);">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-m-0">Dokumenty sprzedaży</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" Class="rz-m-0 rz-font-weight-bold">@summaryData.InvoicesCount szt.</RadzenText>
                </RadzenStack>
                <RadzenIcon Icon="receipt_long" Class="rz-color-success" Style="font-size: 2rem;" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <!-- 4. KOREKTY -->
    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
        <RadzenCard Variant="Variant.Filled" Class="rz-p-3" Style="border-left: 4px solid var(--rz-warning);">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-m-0">Wystawione korekty</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" Class="rz-m-0 rz-font-weight-bold">@correctionsCount szt.</RadzenText>
                </RadzenStack>
                <RadzenIcon Icon="published_with_changes" Class="rz-color-warning" Style="font-size: 2rem;" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private string selectedPeriodType = "Miesiąc";
    private string selectedMonth = "";
    private string selectedQuarter = "";
    private string selectedYear = DateTime.Now.Year.ToString();

    private string selectedPeriodLabel = "";
    private SummaryModel summaryData = new();
    private int correctionsCount = 0;

    private List<string> periodTypes = new() { "Miesiąc", "Kwartał", "Rok" };
    private List<string> monthsList = HelperService.GetPolishMonths();
    private List<string> quartersList = HelperService.GetQuarters();
    private List<string> yearsList = new();

    protected override async Task OnInitializedAsync()
    {
        int currentYear = DateTime.Now.Year;
        yearsList = Enumerable.Range(currentYear - 3, 5).OrderByDescending(y => y).Select(y => y.ToString()).ToList();

        selectedYear = currentYear.ToString();
        selectedMonth = monthsList[DateTime.Now.Month - 1];

        int currentQuarterIdx = (DateTime.Now.Month - 1) / 3;
        selectedQuarter = quartersList[Math.Min(currentQuarterIdx, quartersList.Count - 1)];

        await RefreshDataAsync();
    }

    private async Task OnPeriodTypeChanged(string newType)
    {
        selectedPeriodType = newType;
        if (newType == "Kwartał" && string.IsNullOrEmpty(selectedQuarter))
        {
            int currentQuarterIdx = (DateTime.Now.Month - 1) / 3;
            selectedQuarter = quartersList[Math.Min(currentQuarterIdx, quartersList.Count - 1)];
        }
        else if (newType == "Miesiąc" && string.IsNullOrEmpty(selectedMonth))
        {
            selectedMonth = monthsList[DateTime.Now.Month - 1];
        }

        await RefreshDataAsync();
    }

    private async Task OnMonthChanged(string newMonth)
    {
        selectedMonth = newMonth;
        await RefreshDataAsync();
    }

    private async Task OnQuarterChanged(string newQuarter)
    {
        selectedQuarter = newQuarter;
        await RefreshDataAsync();
    }

    private async Task OnYearChanged(string newYear)
    {
        selectedYear = newYear;
        await RefreshDataAsync();
    }

    public async Task RefreshDataAsync()
    {
        selectedPeriodLabel = selectedPeriodType switch
        {
            "Miesiąc" => $"{selectedMonth} {selectedYear} r.",
            "Kwartał" => $"{selectedQuarter} {selectedYear} r.",
            "Rok" => $"Cały rok {selectedYear}",
            _ => selectedYear
        };

        string detail = selectedPeriodType == "Miesiąc" ? selectedMonth : selectedQuarter;
        summaryData = await DashboardService.GetSummaryForDynamicPeriodAsync(selectedPeriodType, detail, selectedYear);

        var allInvoices = await FakturaService.GetInvoicesAsync();
        var correctionsQuery = allInvoices.Where(i => i.Faktura_Typ == 1 || (i.Faktura_Numer != null && i.Faktura_Numer.Contains("FK")));

        if (int.TryParse(selectedYear, out int yearVal))
        {
            correctionsQuery = correctionsQuery.Where(i => (i.Usluga_Data != default ? i.Usluga_Data.Year : i.Faktura_Data.Year) == yearVal);

            if (selectedPeriodType == "Miesiąc")
            {
                int monthIndex = monthsList.IndexOf(selectedMonth) + 1;
                if (monthIndex > 0)
                {
                    correctionsQuery = correctionsQuery.Where(i => (i.Usluga_Data != default ? i.Usluga_Data.Month : i.Faktura_Data.Month) == monthIndex);
                }
            }
            else if (selectedPeriodType == "Kwartał")
            {
                int quarterNumber = quartersList.IndexOf(selectedQuarter) + 1;
                if (quarterNumber > 0)
                {
                    int startMonth = (quarterNumber - 1) * 3 + 1;
                    int endMonth = startMonth + 2;
                    correctionsQuery = correctionsQuery.Where(i =>
                    {
                        int m = i.Usluga_Data != default ? i.Usluga_Data.Month : i.Faktura_Data.Month;
                        return m >= startMonth && m <= endMonth;
                    });
                }
            }
        }

        correctionsCount = correctionsQuery.Count();
        StateHasChanged();
    }

    private string FormatPLN(decimal amount) => $"{amount:N2}\u00A0zł";
}