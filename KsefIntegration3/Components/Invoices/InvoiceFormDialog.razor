<RadzenStack Gap="1.5rem" Class="rz-p-2" Style="max-height: 85vh; overflow-y: auto;">

    @if (CorrectedInvoice != null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Title="Dokument korygujący" Class="rz-m-0">
            Wystawiasz korektę do faktury <strong>@CorrectedInvoice.Faktura_Numer</strong> z dnia @CorrectedInvoice.Faktura_Data.ToString("dd.MM.yyyy").
        </RadzenAlert>
    }

    <!-- SEKCJA 1: DANE PODSTAWOWE I SPRZEDAWCA -->
    <RadzenCard Variant="Variant.Filled" Class="rz-p-4">
        <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-color-primary rz-m-0 rz-font-weight-bold">
            Dane Podstawowe i Sprzedawca
        </RadzenText>
        <RadzenDivider Class="rz-my-2" />
        
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Numer dokumentu</RadzenText>
                <RadzenTextBox @bind-Value="@model.Faktura_Numer" Disabled="true" Style="width: 100%; opacity: 0.7;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Data wystawienia</RadzenText>
                <RadzenDatePicker @bind-Value="@model.Faktura_Data" DateFormat="dd.MM.yyyy" Max="@DateTime.Today" Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Data sprzedaży</RadzenText>
                <RadzenDatePicker @bind-Value="@model.Usluga_Data" DateFormat="dd.MM.yyyy" Max="@DateTime.Today" Style="@GetHighlightStyle(model.Usluga_Data != CorrectedInvoice?.Usluga_Data)" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem" Class="rz-mt-2">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Nazwa firmy sprzedawcy</RadzenText>
                <RadzenTextBox @bind-Value="@model.Sprzedawca_Nazwa" Style="width: 100%;" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">NIP sprzedawcy</RadzenText>
                <RadzenTextBox @bind-Value="@model.Sprzedawca_NIP"
                               Style="@(CorrectedInvoice != null ? "width: 100%; opacity: 0.6; cursor: not-allowed;" : "width: 100%;")"
                               Disabled="@(CorrectedInvoice != null)" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem" Class="rz-mt-2">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Miejsce wystawienia</RadzenText>
                <RadzenTextBox @bind-Value="@model.Faktura_MiejsceWystawienia" Style="@GetHighlightStyle(model.Faktura_MiejsceWystawienia != CorrectedInvoice?.Faktura_MiejsceWystawienia)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Forma płatności</RadzenText>
                <RadzenDropDown @bind-Value="@model.Platnosc_Nazwa" Data="@paymentMethods" Style="@GetHighlightStyle(model.Platnosc_Nazwa != CorrectedInvoice?.Platnosc_Nazwa)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Termin płatności</RadzenText>
                <RadzenNumeric TValue="int?" @bind-Value="@model.Platnosc_Termin" Min="0" Style="@GetHighlightStyle(model.Platnosc_Termin != CorrectedInvoice?.Platnosc_Termin)" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- SEKCJA 2: DANE NABYWCY I ODBIORCY -->
    <RadzenCard Variant="Variant.Filled" Class="rz-p-4">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-color-primary rz-m-0 rz-font-weight-bold">
                Dane Nabywcy
            </RadzenText>
            @if (CorrectedInvoice == null)
            {
                <RadzenCard Variant="Variant.Outlined" Class="rz-px-3 rz-py-1 rz-m-0">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox @bind-Value="@isBuyerPerson" Name="cbBuyerPerson" TValue="bool" Change="@OnBuyerTypeChanged" />
                        <RadzenLabel Text="Osoba fizyczna" Component="cbBuyerPerson" Class="rz-font-weight-bold" Style="cursor: pointer; font-size: 0.9rem;" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
        <RadzenDivider Class="rz-my-2" />

        @if (CorrectedInvoice == null)
        {
            <RadzenRow Gap="1rem" AlignItems="AlignItems.End" Class="rz-mb-2">
                <RadzenColumn Size="12" SizeMD="@(isBuyerPerson ? 12 : 9)">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                        @(isBuyerPerson ? "Wybierz osobę z bazy kontrahentów" : "Wybierz firmę z bazy kontrahentów")
                    </RadzenText>
                    <RadzenDropDown TValue="Kontrahent" Data="@BuyerContractorsList" TextProperty="DisplayName"
                                    Value="@selectedContractor" Change="@OnContractorSelected"
                                    Placeholder="Wybierz z listy kontrahentów..." Style="width: 100%;" AllowClear="true" />
                </RadzenColumn>
                @if (!isBuyerPerson)
                {
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenButton Text="Pobierz z GUS" Icon="search" ButtonStyle="ButtonStyle.Secondary"
                                      Click="@FetchGusForBuyer" IsBusy="@isLoadingGus" Style="width: 100%; height: 38px;" />
                    </RadzenColumn>
                }
            </RadzenRow>
        }

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="@(isBuyerPerson ? 12 : 7)">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                    @(isBuyerPerson ? "Imię i nazwisko nabywcy" : "Nazwa nabywcy")
                </RadzenText>
                <RadzenTextBox @bind-Value="@model.Nabywca_Nazwa" Placeholder="@(isBuyerPerson ? "Jan Kowalski" : "Tatry Ski Corp")" Style="@GetHighlightStyle(model.Nabywca_Nazwa != CorrectedInvoice?.Nabywca_Nazwa)" />
            </RadzenColumn>
            @if (!isBuyerPerson)
            {
                <RadzenColumn Size="12" SizeMD="5">
                    <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                        NIP nabywcy
                    </RadzenText>
                    <RadzenTextBox @bind-Value="@model.Nabywca_NIP"
                                   Placeholder="10 cyfr NIP"
                                   Style="@(CorrectedInvoice != null ? "width: 100%; opacity: 0.6; cursor: not-allowed;" : "width: 100%;")"
                                   Disabled="@(CorrectedInvoice != null)" />
                </RadzenColumn>
            }
        </RadzenRow>

        <RadzenRow Gap="1rem" Class="rz-mt-2">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Ulica</RadzenText>
                <RadzenTextBox @bind-Value="@model.Nabywca_Ulica" Placeholder="Krupówki" Style="@GetHighlightStyle(model.Nabywca_Ulica != CorrectedInvoice?.Nabywca_Ulica)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Numer domu</RadzenText>
                <RadzenTextBox @bind-Value="@model.Nabywca_UlicaNumer" Placeholder="12A" Style="@GetHighlightStyle(model.Nabywca_UlicaNumer != CorrectedInvoice?.Nabywca_UlicaNumer)" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem" Class="rz-mt-2">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Kod pocztowy</RadzenText>
                <RadzenTextBox @bind-Value="@model.Nabywca_KodPocztowy" Placeholder="34-500" Style="@GetHighlightStyle(model.Nabywca_KodPocztowy != CorrectedInvoice?.Nabywca_KodPocztowy)" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Miejscowość</RadzenText>
                <RadzenTextBox @bind-Value="@model.Nabywca_Miejscowosc" Placeholder="Zakopane" Style="@GetHighlightStyle(model.Nabywca_Miejscowosc != CorrectedInvoice?.Nabywca_Miejscowosc)" />
            </RadzenColumn>
        </RadzenRow>

        <!-- PRZEŁĄCZNIK ODBIORCY -->
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Class="rz-mt-3">
            <RadzenCheckBox @bind-Value="@hasDifferentRecipient" Name="cbRecipient" TValue="bool" Change="@OnHasRecipientToggle" Disabled="@(CorrectedInvoice != null)" />
            <RadzenLabel Text="Inny odbiorca na fakturze" Component="cbRecipient" Class="rz-font-weight-bold" Style="cursor: pointer;" />
        </RadzenStack>

        @if (hasDifferentRecipient)
        {
            <RadzenCard Variant="Variant.Outlined" Class="rz-mt-3 rz-p-3" Style="border: 1px dashed var(--rz-primary);">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Class="rz-color-primary rz-m-0 rz-font-weight-bold">
                        Dane Odbiorcy
                    </RadzenText>
                    @if (CorrectedInvoice == null)
                    {
                        <RadzenCard Variant="Variant.Outlined" Class="rz-px-3 rz-py-1 rz-m-0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenCheckBox @bind-Value="@isRecipientPerson" Name="cbRecipPerson" TValue="bool" Change="@OnRecipientTypeChanged" />
                                <RadzenLabel Text="Osoba fizyczna" Component="cbRecipPerson" Class="rz-font-weight-bold" Style="cursor: pointer; font-size: 0.9rem;" />
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
                <RadzenDivider Class="rz-my-2" />

                @if (CorrectedInvoice == null)
                {
                    <RadzenRow Gap="1rem" AlignItems="AlignItems.End" Class="rz-mb-2">
                        <RadzenColumn Size="12" SizeMD="@(isRecipientPerson ? 12 : 9)">
                            <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                                @(isRecipientPerson ? "Wybierz odbiorcę z bazy kontrahentów" : "Wybierz odbiorcę z bazy firm")
                            </RadzenText>
                            <RadzenDropDown TValue="Kontrahent" Data="@RecipientContractorsList" TextProperty="DisplayName"
                                            Value="@selectedRecipient" Change="@OnRecipientSelected"
                                            Placeholder="Wybierz odbiorcę..." Style="width: 100%;" AllowClear="true" />
                        </RadzenColumn>
                        @if (!isRecipientPerson)
                        {
                            <RadzenColumn Size="12" SizeMD="3">
                                <RadzenButton Text="Pobierz z GUS" Icon="search" ButtonStyle="ButtonStyle.Secondary"
                                              Click="@FetchGusForRecipient" IsBusy="@isLoadingGusRecipient" Style="width: 100%; height: 38px;" />
                            </RadzenColumn>
                        }
                    </RadzenRow>
                }

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="@(isRecipientPerson ? 12 : 7)">
                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                            @(isRecipientPerson ? "Imię i nazwisko odbiorcy" : "Nazwa odbiorcy")
                        </RadzenText>
                        <RadzenTextBox @bind-Value="@model.Odbiorca_Nazwa" Placeholder="@(isRecipientPerson ? "Anna Nowak" : "Oddział Zakopane")" Style="@GetHighlightStyle(model.Odbiorca_Nazwa != CorrectedInvoice?.Odbiorca_Nazwa)" />
                    </RadzenColumn>
                    @if (!isRecipientPerson)
                    {
                        <RadzenColumn Size="12" SizeMD="5">
                            <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                                NIP odbiorcy
                            </RadzenText>
                            <RadzenTextBox @bind-Value="@model.Odbiorca_NIP"
                                           Placeholder="NIP odbiorcy"
                                           Style="@(CorrectedInvoice != null ? "width: 100%; opacity: 0.6; cursor: not-allowed;" : "width: 100%;")"
                                           Disabled="@(CorrectedInvoice != null)" />
                        </RadzenColumn>
                    }
                </RadzenRow>

                <RadzenRow Gap="1rem" Class="rz-mt-2">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Ulica</RadzenText>
                        <RadzenTextBox @bind-Value="@model.Odbiorca_Ulica" Style="@GetHighlightStyle(model.Odbiorca_Ulica != CorrectedInvoice?.Odbiorca_Ulica)" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Numer domu</RadzenText>
                        <RadzenTextBox @bind-Value="@model.Odbiorca_UlicaNumer" Style="@GetHighlightStyle(model.Odbiorca_UlicaNumer != CorrectedInvoice?.Odbiorca_UlicaNumer)" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem" Class="rz-mt-2">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Kod pocztowy</RadzenText>
                        <RadzenTextBox @bind-Value="@model.Odbiorca_KodPocztowy" Style="@GetHighlightStyle(model.Odbiorca_KodPocztowy != CorrectedInvoice?.Odbiorca_KodPocztowy)" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Miejscowość</RadzenText>
                        <RadzenTextBox @bind-Value="@model.Odbiorca_Miejscowosc" Style="@GetHighlightStyle(model.Odbiorca_Miejscowosc != CorrectedInvoice?.Odbiorca_Miejscowosc)" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        }
    </RadzenCard>

    <!-- SEKCJA 3: POZYCJE FAKTURY -->
    <RadzenCard Variant="Variant.Filled" Class="rz-p-4">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-color-primary rz-m-0 rz-font-weight-bold">Pozycje Faktury</RadzenText>
            <RadzenButton Text="Dodaj pozycję" Icon="add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@AddPosition" />
        </RadzenStack>
        <RadzenDivider Class="rz-my-2" />

        @if (isLoadingPositions)
        {
            <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate" Class="rz-my-2" />
        }
        else
        {
            <RadzenDataGrid @ref="grid" Data="@pozycjeList" TItem="FakturaPozycja" AllowPaging="false" AllowSorting="false">
                <Columns>
                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="Cennik" Width="190px">
                        <Template Context="item">
                            <RadzenDropDown TValue="Towary" Data="@itemsList" TextProperty="Nazwa"
                                            Placeholder="Wybierz towar..." Style="width: 100%;"
                                            Change="@((object val) => OnDictionaryItemSelect(item, val))" AllowClear="true" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="Nazwa pozycji">
                        <Template Context="item">
                            <RadzenTextBox @bind-Value="@item.Pozycja_Nazwa"
                                           Style="@GetItemHighlightStyle(item, nameof(FakturaPozycja.Pozycja_Nazwa))"
                                           Placeholder="Opis pozycji..." />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="Ilość" Width="85px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenNumeric TValue="int" Value="@item.Pozycja_Ilosc"
                                           ValueChanged="@((int val) => OnIloscChanged(item, val))"
                                           Style="@GetItemHighlightStyle(item, nameof(FakturaPozycja.Pozycja_Ilosc))" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="Cena Netto" Width="125px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenNumeric TValue="decimal" Value="@item.Pozycja_Cena_Netto" Format="N2"
                                           ValueChanged="@((decimal val) => OnNettoChanged(item, val))"
                                           Style="@GetItemHighlightStyle(item, nameof(FakturaPozycja.Pozycja_Cena_Netto))" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="VAT" Width="95px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenDropDown Value="@item.Pozycja_Stawka_VAT" Data="@vatRates"
                                            ValueChanged="@((string val) => OnVatChanged(item, val))"
                                            Style="@GetItemHighlightStyle(item, nameof(FakturaPozycja.Pozycja_Stawka_VAT))" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="Cena Brutto" Width="125px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenNumeric TValue="decimal" Value="@item.Pozycja_Cena_Brutto" Format="N2"
                                           ValueChanged="@((decimal val) => OnBruttoChanged(item, val))"
                                           Style="@GetItemHighlightStyle(item, nameof(FakturaPozycja.Pozycja_Cena_Brutto))" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="Wartość Cała" Width="135px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0"><strong>@item.Pozycja_Wartosc_B.ToString("N2") zł</strong></RadzenText>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="FakturaPozycja" Title="" Width="50px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => RemovePosition(item))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>

    <!-- SEKCJA 4: PODSUMOWANIE I UWAGI -->
    <RadzenCard Variant="Variant.Filled" Class="rz-p-4">
        <RadzenRow Gap="1.5rem">
            <RadzenColumn Size="12" SizeMD="7">
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                    @(CorrectedInvoice != null ? "Przyczyna korekty" : "Uwagi do faktury")
                </RadzenText>
                <RadzenTextArea @bind-Value="@model.Faktura_Uwagi" Rows="4" Style="@GetHighlightStyle(model.Faktura_Uwagi != CorrectedInvoice?.Faktura_Uwagi, "width: 100%;")" Placeholder="@(CorrectedInvoice != null ? "Wpisz powód wystawienia korekty..." : "Dodatkowe informacje na fakturze...")" />
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="5">
                <RadzenCard Variant="Variant.Outlined" Class="rz-p-3" Style="height: 100%; display: flex; flex-direction: column; justify-content: space-around;">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary rz-m-0">Suma Netto:</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0 rz-font-weight-bold">@SumaNetto.ToString("N2") zł</RadzenText>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-text-secondary rz-m-0">Suma VAT:</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-m-0 rz-font-weight-bold">@SumaVat.ToString("N2") zł</RadzenText>
                    </RadzenStack>
                    <RadzenDivider Class="rz-my-1" />
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.H6" Class="rz-color-primary rz-m-0 rz-font-weight-bold">Razem Brutto:</RadzenText>
                        <RadzenText TextStyle="TextStyle.H6" Class="rz-color-primary rz-m-0 rz-font-weight-bold">@SumaBrutto.ToString("N2") zł</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- PRZYCISKI AKCJI -->
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Class="rz-pt-2" Gap="1rem">
        <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@Cancel" />
        <RadzenButton Text="@(CorrectedInvoice != null ? "Zapisz i wyślij korektę do KSeF" : "Zapisz i wyślij fakturę do KSeF")"
                      Icon="cloud_upload" ButtonStyle="@(CorrectedInvoice != null ? ButtonStyle.Warning : ButtonStyle.Primary)" Click="@Save" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public Faktura? CorrectedInvoice { get; set; }

    private RadzenDataGrid<FakturaPozycja>? grid;
    private Faktura model = new();
    private List<FakturaPozycja> pozycjeList = new();
    private List<FakturaPozycja> originalPositionsSnapshot = new();

    private List<Kontrahent> contractorsList = new();
    private Kontrahent? selectedContractor;
    private Kontrahent? selectedRecipient;

    private List<Towary> itemsList = new();

    private bool isBuyerPerson = false;
    private bool isRecipientPerson = false;
    private bool isLoadingGus = false;
    private bool isLoadingGusRecipient = false;
    private bool isLoadingPositions = false;
    private bool isSaving = false;
    private bool hasDifferentRecipient = false;

    private List<string> paymentMethods = new() { "Przelew", "Gotówka", "Karta", "Kompensata" };
    private List<string> vatRates = new() { "23%", "8%", "5%", "0%", "zw" };

    private IEnumerable<Kontrahent> BuyerContractorsList => contractorsList.Where(k => isBuyerPerson ? (k.Typ == "Osoba fizyczna" || k.Kontrahent_Rodzaj == 2) : (k.Typ != "Osoba fizyczna" && k.Kontrahent_Rodzaj != 2));
    private IEnumerable<Kontrahent> RecipientContractorsList => contractorsList.Where(k => isRecipientPerson ? (k.Typ == "Osoba fizyczna" || k.Kontrahent_Rodzaj == 2) : (k.Typ != "Osoba fizyczna" && k.Kontrahent_Rodzaj != 2));

    private string GetHighlightStyle(bool isChanged, string baseStyle = "width: 100%;")
    {
        if (CorrectedInvoice != null && isChanged)
        {
            return $"{baseStyle} background-color: #fffde7; border: 1px solid #fbc02d; font-weight: 500;";
        }
        return baseStyle;
    }

    private string GetItemHighlightStyle(FakturaPozycja item, string propertyName)
    {
        if (CorrectedInvoice == null) return "width: 100%;";

        int index = pozycjeList.IndexOf(item);
        if (index < 0 || index >= originalPositionsSnapshot.Count)
        {
            return "width: 100%; background-color: #fffde7; border: 1px solid #fbc02d; font-weight: 500;";
        }

        var orig = originalPositionsSnapshot[index];
        bool isDiff = propertyName switch
        {
            nameof(FakturaPozycja.Pozycja_Nazwa) => item.Pozycja_Nazwa != orig.Pozycja_Nazwa,
            nameof(FakturaPozycja.Pozycja_Ilosc) => item.Pozycja_Ilosc != orig.Pozycja_Ilosc,
            nameof(FakturaPozycja.Pozycja_Cena_Netto) => item.Pozycja_Cena_Netto != orig.Pozycja_Cena_Netto,
            nameof(FakturaPozycja.Pozycja_Cena_Brutto) => item.Pozycja_Cena_Brutto != orig.Pozycja_Cena_Brutto,
            nameof(FakturaPozycja.Pozycja_Stawka_VAT) => item.Pozycja_Stawka_VAT != orig.Pozycja_Stawka_VAT,
            _ => false
        };

        return isDiff ? "width: 100%; background-color: #fffde7; border: 1px solid #fbc02d; font-weight: 500;" : "width: 100%;";
    }

    protected override async Task OnInitializedAsync()
    {
        model.Faktura_Data = DateTime.Now;
        model.Usluga_Data = DateTime.Now;
        model.Platnosc_Nazwa = "Przelew";
        model.Platnosc_Termin = 14;

        var companyConfig = await ConfigurationService.GetConfigurationDataAsync();
        if (companyConfig != null)
        {
            model.Sprzedawca_Nazwa = companyConfig.Sprzedawca_Nazwa;
            model.Sprzedawca_NIP = companyConfig.Sprzedawca_NIP;
            model.Sprzedawca_Ulica = companyConfig.Sprzedawca_Ulica;
            model.Sprzedawca_Numer = companyConfig.Sprzedawca_UlicaNr;
            model.Sprzedawca_KodPocztowy = companyConfig.Sprzedawca_KodPocztowy;
            model.Sprzedawca_Miejscowosc = companyConfig.Sprzedawca_Miejscowosc;

            model.Faktura_MiejsceWystawienia = !string.IsNullOrWhiteSpace(companyConfig.Faktura_MiejsceWystawienia)
                            ? companyConfig.Faktura_MiejsceWystawienia
                            : companyConfig.Sprzedawca_Miejscowosc;
        }

        bool isCorr = CorrectedInvoice != null;
        var (rawNumber, formattedNumber) = await ConfigurationService.GetNextInvoiceNumberDataAsync(isCorr);

        model.Numer = rawNumber;
        model.Faktura_Numer = formattedNumber;

        if (CorrectedInvoice != null)
        {
            model.Faktura_Typ = 1;
            model.oGuid = CorrectedInvoice.Guid;

            model.Nabywca_Nazwa = CorrectedInvoice.Nabywca_Nazwa;
            model.Nabywca_NIP = CorrectedInvoice.Nabywca_NIP;
            model.Nabywca_Ulica = CorrectedInvoice.Nabywca_Ulica;
            model.Nabywca_UlicaNumer = CorrectedInvoice.Nabywca_UlicaNumer;
            model.Nabywca_KodPocztowy = CorrectedInvoice.Nabywca_KodPocztowy;
            model.Nabywca_Miejscowosc = CorrectedInvoice.Nabywca_Miejscowosc;

            model.Odbiorca_Nazwa = CorrectedInvoice.Odbiorca_Nazwa;
            model.Odbiorca_NIP = CorrectedInvoice.Odbiorca_NIP;
            model.Odbiorca_Ulica = CorrectedInvoice.Odbiorca_Ulica;
            model.Odbiorca_UlicaNumer = CorrectedInvoice.Odbiorca_UlicaNumer;
            model.Odbiorca_KodPocztowy = CorrectedInvoice.Odbiorca_KodPocztowy;
            model.Odbiorca_Miejscowosc = CorrectedInvoice.Odbiorca_Miejscowosc;

            model.Platnosc_Nazwa = CorrectedInvoice.Platnosc_Nazwa;
            model.Platnosc_Termin = CorrectedInvoice.Platnosc_Termin;
            model.Usluga_Data = CorrectedInvoice.Usluga_Data;

            isBuyerPerson = string.IsNullOrWhiteSpace(model.Nabywca_NIP);
            isRecipientPerson = string.IsNullOrWhiteSpace(model.Odbiorca_NIP);
            hasDifferentRecipient = !string.IsNullOrWhiteSpace(model.Odbiorca_Nazwa) && model.Odbiorca_Nazwa != model.Nabywca_Nazwa;

            string rootInvoiceNumber = CorrectedInvoice.Faktura_Numer ?? string.Empty;
            if ((CorrectedInvoice.Faktura_Numer?.Contains("FK") ?? false) || CorrectedInvoice.Faktura_Typ == 1)
            {
                if (!string.IsNullOrWhiteSpace(CorrectedInvoice.Faktura_Uwagi) && CorrectedInvoice.Faktura_Uwagi.Contains("Korekta do faktury nr "))
                {
                    var parts = CorrectedInvoice.Faktura_Uwagi.Split("Korekta do faktury nr ");
                    if (parts.Length > 1)
                    {
                        rootInvoiceNumber = parts[1].Split(' ')[0].Trim();
                    }
                }
                model.Faktura_Uwagi = $"Korekta do faktury nr {rootInvoiceNumber} (koryguje {CorrectedInvoice.Faktura_Numer})";
            }
            else
            {
                model.Faktura_Uwagi = $"Korekta do faktury nr {rootInvoiceNumber}";
            }

            isLoadingPositions = true;
            StateHasChanged();

            var originalPositions = await FakturaService.GetInvoicePositionsAsync(CorrectedInvoice.Guid);
            pozycjeList = new List<FakturaPozycja>();
            originalPositionsSnapshot = new List<FakturaPozycja>();

            foreach (var orig in originalPositions)
            {
                string vatStr = string.IsNullOrWhiteSpace(orig.Pozycja_Stawka_VAT) ? "23%" : (orig.Pozycja_Stawka_VAT.EndsWith("%") ? orig.Pozycja_Stawka_VAT : $"{orig.Pozycja_Stawka_VAT}%");

                var snapshotPos = new FakturaPozycja
                {
                    Pozycja_Nazwa = orig.Pozycja_Nazwa,
                    Pozycja_Ilosc = orig.Pozycja_Ilosc,
                    Pozycja_Cena_Netto = orig.Pozycja_Cena_Netto,
                    Pozycja_Cena_Brutto = orig.Pozycja_Cena_Brutto,
                    Pozycja_Stawka_VAT = vatStr
                };
                originalPositionsSnapshot.Add(snapshotPos);

                var newPos = new FakturaPozycja
                {
                    Guid = Guid.NewGuid(),
                    Pozycja_Nazwa = orig.Pozycja_Nazwa,
                    Pozycja_Ilosc = orig.Pozycja_Ilosc,
                    Pozycja_Cena_Netto = orig.Pozycja_Cena_Netto,
                    Pozycja_Cena_Brutto = orig.Pozycja_Cena_Brutto,
                    Pozycja_Stawka_VAT = vatStr,
                    Towar_Guid = orig.Towar_Guid
                };

                RecalculateFromNetto(newPos);
                pozycjeList.Add(newPos);
                CorrectedInvoice.FakturaPozycje.Add(newPos);
            }

            isLoadingPositions = false;
        }
        else
        {
            model.Faktura_Typ = 0;
            AddPosition();
        }

        var contractorsTask = KontrahentService.GetContractorsAsync();
        var itemsTask = TowaryService.GetDictionaryItemsAsync();

        await Task.WhenAll(contractorsTask, itemsTask);

        contractorsList = await contractorsTask;
        itemsList = await itemsTask;
    }

