    private decimal GetVatMultiplier(string? vatStr)
    {
        return vatStr switch
        {
            "23%" => 1.23m,
            "8%" => 1.08m,
            "5%" => 1.05m,
            _ => 1.00m
        };
    }

    private decimal GetVatRateDecimal(string? vatStr)
    {
        return vatStr switch
        {
            "23%" => 0.23m,
            "8%" => 0.08m,
            "5%" => 0.05m,
            _ => 0.00m
        };
    }

    private void OnNettoChanged(FakturaPozycja item, decimal newNetto)
    {
        item.Pozycja_Cena_Netto = newNetto;
        RecalculateFromNetto(item);
    }

    private void OnBruttoChanged(FakturaPozycja item, decimal newBrutto)
    {
        item.Pozycja_Cena_Brutto = newBrutto;
        RecalculateFromBrutto(item);
    }

    private void OnVatChanged(FakturaPozycja item, string newVat)
    {
        item.Pozycja_Stawka_VAT = newVat;
        RecalculateFromNetto(item);
    }

    private void OnIloscChanged(FakturaPozycja item, int newQty)
    {
        item.Pozycja_Ilosc = newQty;
        RecalculateTotals(item);
    }

    private void RecalculateFromNetto(FakturaPozycja item)
    {
        decimal multiplier = GetVatMultiplier(item.Pozycja_Stawka_VAT);
        item.Pozycja_Cena_Brutto = Math.Round(item.Pozycja_Cena_Netto * multiplier, 2);
        RecalculateTotals(item);
    }

    private void RecalculateFromBrutto(FakturaPozycja item)
    {
        decimal multiplier = GetVatMultiplier(item.Pozycja_Stawka_VAT);
        item.Pozycja_Cena_Netto = Math.Round(item.Pozycja_Cena_Brutto / multiplier, 2);
        RecalculateTotals(item);
    }

    private void RecalculateTotals(FakturaPozycja item)
    {
        decimal vatRate = GetVatRateDecimal(item.Pozycja_Stawka_VAT);
        item.Pozycja_Wartosc_N = Math.Round(item.Pozycja_Cena_Netto * item.Pozycja_Ilosc, 2);
        item.Pozycja_Wartosc_VAT = Math.Round(item.Pozycja_Wartosc_N * vatRate, 2);
        item.Pozycja_Wartosc_B = item.Pozycja_Wartosc_N + item.Pozycja_Wartosc_VAT;
    }

    private decimal SumaNetto => pozycjeList.Sum(p => p.Pozycja_Wartosc_N);
    private decimal SumaVat => pozycjeList.Sum(p => p.Pozycja_Wartosc_VAT);
    private decimal SumaBrutto => pozycjeList.Sum(p => p.Pozycja_Wartosc_B);

    private void Cancel() => DialogService.Close(null);

    private async Task Save()
    {
        if (isSaving) return;

        if (string.IsNullOrWhiteSpace(model.Faktura_Numer))
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brakujące dane", "Brak numeru dokumentu.");
            return;
        }

        using (var context = await DbContextFactory.CreateDbContextAsync())
        {
            string numberToCheck = model.Faktura_Numer.Trim();
            bool numberExists = await context.Faktury.AnyAsync(f => 
                !f.is_Deleted && 
                f.Faktura_Numer.Trim() == numberToCheck && 
                f.Guid != model.Guid);

            if (numberExists)
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Error, "Duplikat numeru", $"Dokument o numerze '{numberToCheck}' już istnieje w bazie! Skontaktuj się z administratorem.");
                return;
            }
        }

        if (model.Usluga_Data > model.Data.AddDays(30))
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Niepoprawna data", "Data sprzedaży nie może wyprzedzać daty wystawienia faktury o więcej niż 30 dni.");
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Nabywca_Nazwa))
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brakujące dane", isBuyerPerson ? "Wpisz imię i nazwisko nabywcy." : "Wpisz nazwę firmy nabywcy.");
            return;
        }

        if (!isBuyerPerson && CorrectedInvoice == null)
        {
            if (string.IsNullOrWhiteSpace(model.Nabywca_NIP))
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brakujące dane", "Wpisz NIP firmy nabywcy.");
                return;
            }

            string cleanBuyerNip = model.Nabywca_NIP.Replace("-", "").Replace(" ", "").Trim();
            if (cleanBuyerNip.Length != 10 || !cleanBuyerNip.All(char.IsDigit))
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Błędny NIP", "NIP Nabywcy musi składać się z dokładnie 10 cyfr.");
                return;
            }
            model.Nabywca_NIP = cleanBuyerNip;
        }

        if (string.IsNullOrWhiteSpace(model.Nabywca_Ulica) || string.IsNullOrWhiteSpace(model.Nabywca_UlicaNumer) || string.IsNullOrWhiteSpace(model.Nabywca_Miejscowosc) || string.IsNullOrWhiteSpace(model.Nabywca_KodPocztowy))
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brakujące dane", "Uzupełnij pełny adres nabywcy (ulica, nr, miejscowość, kod pocztowy).");
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(model.Nabywca_KodPocztowy.Trim(), @"^[0-9]{2}-[0-9]{3}$"))
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Błędny kod pocztowy", "Kod pocztowy nabywcy musi mieć format XX-XXX.");
            return;
        }

        if (hasDifferentRecipient)
        {
            if (string.IsNullOrWhiteSpace(model.Odbiorca_Nazwa))
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brakujące dane", isRecipientPerson ? "Wpisz imię i nazwisko odbiorcy." : "Wpisz nazwę odbiorcy.");
                return;
            }

            if (!isRecipientPerson && !string.IsNullOrWhiteSpace(model.Odbiorca_NIP) && CorrectedInvoice == null)
            {
                string cleanRecipNip = model.Odbiorca_NIP.Replace("-", "").Replace(" ", "").Trim();
                if (cleanRecipNip.Length != 10 || !cleanRecipNip.All(char.IsDigit))
                {
                    await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Błędny NIP", "NIP Odbiorcy musi składać się z dokładnie 10 cyfr.");
                    return;
                }
                model.Odbiorca_NIP = cleanRecipNip;
            }

            if (string.IsNullOrWhiteSpace(model.Odbiorca_Ulica) || string.IsNullOrWhiteSpace(model.Odbiorca_UlicaNumer) || string.IsNullOrWhiteSpace(model.Odbiorca_Miejscowosc) || string.IsNullOrWhiteSpace(model.Odbiorca_KodPocztowy))
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brakujące dane", "Uzupełnij pełny adres odbiorcy.");
                return;
            }

            if (!System.Text.RegularExpressions.Regex.IsMatch(model.Odbiorca_KodPocztowy.Trim(), @"^[0-9]{2}-[0-9]{3}$"))
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Błędny kod pocztowy", "Kod pocztowy odbiorcy musi mieć format XX-XXX.");
                return;
            }
        }
        else
        {
            model.Odbiorca_Nazwa = model.Nabywca_Nazwa;
            model.Odbiorca_NIP = model.Nabywca_NIP;
            model.Odbiorca_Ulica = model.Nabywca_Ulica;
            model.Odbiorca_UlicaNumer = model.Nabywca_UlicaNumer;
            model.Odbiorca_KodPocztowy = model.Nabywca_KodPocztowy;
            model.Odbiorca_Miejscowosc = model.Nabywca_Miejscowosc;
        }

        if (!pozycjeList.Any())
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Brak pozycji", "Dokument musi zawierać co najmniej jedną pozycję.");
            return;
        }

        foreach (var pos in pozycjeList)
        {
            if (string.IsNullOrWhiteSpace(pos.Pozycja_Nazwa))
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Błędna pozycja", "Każda pozycja musi posiadać nazwę.");
                return;
            }

            if (pos.Pozycja_Cena_Netto <= 0)
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Warning, "Błędna cena", $"Cena netto dla pozycji '{pos.Pozycja_Nazwa}' musi być większa od 0.");
                return;
            }
        }

        if (CorrectedInvoice != null)
        {
            string expectedNip = string.IsNullOrWhiteSpace(CorrectedInvoice.Nabywca_NIP) ? "BRAK" : CorrectedInvoice.Nabywca_NIP.Trim();
            string inputNip = string.Empty;

            var confirmResult = await DialogService.OpenAsync(
                "Potwierdzenie zapisu korekty",
                ds =>
                @<RadzenStack Gap="1rem" Class="rz-p-2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="edit" IconStyle="IconStyle.Warning" Style="font-size: 1.8rem;" />
                        <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0">Potwierdzenie korekty</RadzenText>
                    </RadzenStack>

                    <RadzenText TextStyle="TextStyle.Body2">
                        Zamierzasz zapisać korektę do faktury <strong>@CorrectedInvoice.Faktura_Numer</strong>.
                    </RadzenText>

                    <RadzenStack Class="rz-p-3 rz-border-radius-1">
                        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">
                            Aby zatwierdzić, wpisz NIP nabywcy (wymagany: <strong>@expectedNip</strong>):
                        </RadzenText>
                        <RadzenTextBox Change="@(args => inputNip = args)" Style="width: 100%;" Placeholder="Wpisz NIP..." />
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-3">
                        <RadzenButton Text="Anuluj" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => ds.Close(false))" />
                        <RadzenButton Text="Potwierdź i Zapisz" Icon="save" ButtonStyle="ButtonStyle.Warning"
                                      Click="@(() =>
                                      {
                                          if (string.Equals(inputNip.Trim(), expectedNip, StringComparison.OrdinalIgnoreCase))
                                          {
                                              ds.Close(true);
                                          }
                                          else
                                          {
                                              PreferencesService.NotifyAsync(NotificationSeverity.Error, "Błąd", "Wprowadzony NIP jest niepoprawny.");
                                          }
                                      })" />
                    </RadzenStack>
                </RadzenStack>,
                new DialogOptions { Width = "500px" }
            );

            if (confirmResult != true)
            {
                return;
            }
        }

        if (selectedContractor != null)
        {
            bool buyerChanged = !string.Equals(selectedContractor.Ulica?.Trim(), model.Nabywca_Ulica?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                !string.Equals(selectedContractor.NumerDomu?.Trim(), model.Nabywca_UlicaNumer?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                !string.Equals(selectedContractor.Kod_Pocztowy?.Trim(), model.Nabywca_KodPocztowy?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                !string.Equals(selectedContractor.Miejscowosc?.Trim(), model.Nabywca_Miejscowosc?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                !string.Equals(selectedContractor.NIP?.Trim(), model.Nabywca_NIP?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                !string.Equals(selectedContractor.DisplayName?.Trim(), model.Nabywca_Nazwa?.Trim(), StringComparison.OrdinalIgnoreCase);

            if (buyerChanged)
            {
                bool? updateBuyer = await DialogService.Confirm(
                    $"Zmodyfikowano dane wybranego nabywcy '{selectedContractor.DisplayName}'. Czy chcesz zaktualizować jego dane w stałej bazie kontrahentów?",
                    "Aktualizacja kontrahenta",
                    new ConfirmOptions { OkButtonText = "Tak, zaktualizuj w bazie", CancelButtonText = "Nie, zmień tylko na tej fakturze" }
                );

                if (updateBuyer == true)
                {
                    if (isBuyerPerson)
                    {
                        var names = model.Nabywca_Nazwa.Split(' ', 2);
                        selectedContractor.Imie = names[0];
                        selectedContractor.Nazwisko = names.Length > 1 ? names[1] : string.Empty;
                    }
                    else
                    {
                        selectedContractor.Nazwa = model.Nabywca_Nazwa;
                        selectedContractor.NIP = model.Nabywca_NIP;
                    }

                    selectedContractor.Ulica = model.Nabywca_Ulica;
                    selectedContractor.NumerDomu = model.Nabywca_UlicaNumer;
                    selectedContractor.Kod_Pocztowy = model.Nabywca_KodPocztowy;
                    selectedContractor.Miejscowosc = model.Nabywca_Miejscowosc;

                    await KontrahentService.UpdateContractorAsync(selectedContractor);
                }
            }
        }
        else
        {
            bool buyerExists = contractorsList.Any(c =>
                (!string.IsNullOrWhiteSpace(model.Nabywca_NIP) && string.Equals(c.NIP?.Trim(), model.Nabywca_NIP?.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (string.IsNullOrWhiteSpace(model.Nabywca_NIP) && string.Equals(c.DisplayName?.Trim(), model.Nabywca_Nazwa?.Trim(), StringComparison.OrdinalIgnoreCase))
            );

            if (!buyerExists && CorrectedInvoice == null)
            {
                bool? addContractorConfirm = await DialogService.Confirm(
                    $"Nabywca '{model.Nabywca_Nazwa}' nie znajduje się w Twojej stałej bazie kontrahentów. Czy chcesz dodać go do bazy?",
                    "Nowy kontrahent",
                    new ConfirmOptions { OkButtonText = "Tak, dodaj do bazy", CancelButtonText = "Nie, wystaw bez dodawania" }
                );

                if (addContractorConfirm == true)
                {
                    var newContractor = new Kontrahent
                    {
                        Guid = Guid.NewGuid(),
                        Status = true,
                        Kod_Kraju = "PL",
                        Ulica = model.Nabywca_Ulica,
                        NumerDomu = model.Nabywca_UlicaNumer,
                        Kod_Pocztowy = model.Nabywca_KodPocztowy,
                        Miejscowosc = model.Nabywca_Miejscowosc,
                        Typ = isBuyerPerson ? "Osoba fizyczna" : "Firma",
                        Kontrahent_Rodzaj = isBuyerPerson ? 2 : 1
                    };

                    if (isBuyerPerson)
                    {
                        var names = model.Nabywca_Nazwa.Split(' ', 2);
                        newContractor.Imie = names[0];
                        newContractor.Nazwisko = names.Length > 1 ? names[1] : string.Empty;
                    }
                    else
                    {
                        newContractor.Nazwa = model.Nabywca_Nazwa;
                        newContractor.NIP = model.Nabywca_NIP;
                    }

                    await KontrahentService.AddContractorAsync(newContractor);
                    contractorsList = await KontrahentService.GetContractorsAsync();
                }
            }
        }

        if (hasDifferentRecipient)
        {
            if (selectedRecipient != null)
            {
                bool recipientChanged = selectedRecipient.DisplayName != model.Odbiorca_Nazwa ||
                                        selectedRecipient.Ulica != model.Odbiorca_Ulica ||
                                        selectedRecipient.NumerDomu != model.Odbiorca_UlicaNumer ||
                                        selectedRecipient.Kod_Pocztowy != model.Odbiorca_KodPocztowy ||
                                        selectedRecipient.Miejscowosc != model.Odbiorca_Miejscowosc ||
                                        selectedRecipient.NIP != model.Odbiorca_NIP;

                if (recipientChanged)
                {
                    bool? updateRecipient = await DialogService.Confirm(
                        $"Zmodyfikowano dane odbiorcy '{selectedRecipient.DisplayName}'. Czy chcesz zaktualizować jego dane w bazie?",
                        "Aktualizacja odbiorcy",
                        new ConfirmOptions { OkButtonText = "Tak, zaktualizuj w bazie", CancelButtonText = "Nie, zmień tylko na tej fakturze" }
                    );

                    if (updateRecipient == true)
                    {
                        if (isRecipientPerson)
                        {
                            var names = model.Odbiorca_Nazwa.Split(' ', 2);
                            selectedRecipient.Imie = names[0];
                            selectedRecipient.Nazwisko = names.Length > 1 ? names[1] : string.Empty;
                        }
                        else
                        {
                            selectedRecipient.Nazwa = model.Odbiorca_Nazwa;
                            selectedRecipient.NIP = model.Odbiorca_NIP;
                        }

                        selectedRecipient.Ulica = model.Odbiorca_Ulica;
                        selectedRecipient.NumerDomu = model.Odbiorca_UlicaNumer;
                        selectedRecipient.Kod_Pocztowy = model.Odbiorca_KodPocztowy;
                        selectedRecipient.Miejscowosc = model.Odbiorca_Miejscowosc;

                        await KontrahentService.UpdateContractorAsync(selectedRecipient);
                    }
                }
            }
            else if (CorrectedInvoice == null)
            {
                bool recipientExists = contractorsList.Any(c =>
                    (!string.IsNullOrWhiteSpace(model.Odbiorca_NIP) && string.Equals(c.NIP?.Trim(), model.Odbiorca_NIP?.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                    (string.IsNullOrWhiteSpace(model.Odbiorca_NIP) && string.Equals(c.DisplayName?.Trim(), model.Odbiorca_Nazwa?.Trim(), StringComparison.OrdinalIgnoreCase))
                );

                if (!recipientExists)
                {
                    bool? addRecipientConfirm = await DialogService.Confirm(
                        $"Odbiorca '{model.Odbiorca_Nazwa}' nie znajduje się w Twojej bazie kontrahentów. Czy chcesz dodać go do bazy?",
                        "Nowy odbiorca",
                        new ConfirmOptions { OkButtonText = "Tak, dodaj do bazy", CancelButtonText = "Nie, wystaw bez dodawania" }
                    );

                    if (addRecipientConfirm == true)
                    {
                        var newRecipient = new Kontrahent
                        {
                            Guid = Guid.NewGuid(),
                            Status = true,
                            Kod_Kraju = "PL",
                            Ulica = model.Odbiorca_Ulica,
                            NumerDomu = model.Odbiorca_UlicaNumer,
                            Kod_Pocztowy = model.Odbiorca_KodPocztowy,
                            Miejscowosc = model.Odbiorca_Miejscowosc,
                            Typ = isRecipientPerson ? "Osoba fizyczna" : "Firma",
                            Kontrahent_Rodzaj = isRecipientPerson ? 2 : 1
                        };

                        if (isRecipientPerson)
                        {
                            var names = model.Odbiorca_Nazwa.Split(' ', 2);
                            newRecipient.Imie = names[0];
                            newRecipient.Nazwisko = names.Length > 1 ? names[1] : string.Empty;
                        }
                        else
                        {
                            newRecipient.Nazwa = model.Odbiorca_Nazwa;
                            newRecipient.NIP = model.Odbiorca_NIP;
                        }

                        await KontrahentService.AddContractorAsync(newRecipient);
                        contractorsList = await KontrahentService.GetContractorsAsync();
                    }
                }
            }
        }

        foreach (var pos in pozycjeList)
        {
            if (pos.Towar_Guid.HasValue)
            {
                var originalItem = itemsList.FirstOrDefault(i => i.Guid == pos.Towar_Guid.Value);
                if (originalItem != null)
                {
                    int? posVatVal = int.TryParse(pos.Pozycja_Stawka_VAT?.Replace("%", ""), out int pVat) ? pVat : null;
                    bool itemChanged = originalItem.Nazwa != pos.Pozycja_Nazwa ||
                                       originalItem.Cena_Netto != pos.Pozycja_Cena_Netto ||
                                       originalItem.Cena_Brutto != pos.Pozycja_Cena_Brutto ||
                                       originalItem.Stawka_VAT != posVatVal;

                    if (itemChanged)
                    {
                        bool? updateItemConfirm = await DialogService.Confirm(
                            $"Zmodyfikowano cenę lub nazwę pozycji cennikowej '{originalItem.Nazwa}'. Czy chcesz zaktualizować jej cenę w bazie cennika?",
                            "Aktualizacja w cenniku",
                            new ConfirmOptions { OkButtonText = "Tak, zaktualizuj cennik", CancelButtonText = "Nie, zmień tylko na tej fakturze" }
                        );

                        if (updateItemConfirm == true)
                        {
                            originalItem.Nazwa = pos.Pozycja_Nazwa;
                            originalItem.Cena_Netto = pos.Pozycja_Cena_Netto;
                            originalItem.Cena_Brutto = pos.Pozycja_Cena_Brutto;
                            originalItem.Stawka_VAT = posVatVal;

                            await TowaryService.UpdateDictionaryItemAsync(originalItem);
                        }
                    }
                }
            }
        }

        var newItemsToSuggest = pozycjeList
            .Where(p => !p.Towar_Guid.HasValue && !itemsList.Any(i => string.Equals(i.Nazwa?.Trim(), p.Pozycja_Nazwa?.Trim(), StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (newItemsToSuggest.Any())
        {
            string itemNames = string.Join(", ", newItemsToSuggest.Select(i => $"'{i.Pozycja_Nazwa}'"));
            bool? addItemsConfirm = await DialogService.Confirm(
                $"Następujące pozycje nie znajdują się w Twoim cenniku / słowniku: {itemNames}. Czy chcesz dodać je automatycznie do bazy towarów i usług?",
                "Nowe pozycje w cenniku",
                new ConfirmOptions { OkButtonText = "Tak, dodaj do bazy", CancelButtonText = "Nie, zapisz tylko fakturę" }
            );

            if (addItemsConfirm == true)
            {
                foreach (var pos in newItemsToSuggest)
                {
                    int? vatVal = int.TryParse(pos.Pozycja_Stawka_VAT?.Replace("%", ""), out int parsedVat) ? parsedVat : null;

                    var newDictionaryItem = new Towary
                    {
                        Guid = Guid.NewGuid(),
                        Nazwa = pos.Pozycja_Nazwa,
                        Cena_Netto = pos.Pozycja_Cena_Netto,
                        Cena_Brutto = pos.Pozycja_Cena_Brutto,
                        Stawka_VAT = vatVal,
                        Jednostka_Miary = "szt.",
                        Status = true,
                        Rodzaj = 1
                    };

                    await TowaryService.AddDictionaryItemAsync(newDictionaryItem);
                    pos.Towar_Guid = newDictionaryItem.Guid;
                }

                itemsList = await TowaryService.GetDictionaryItemsAsync();
            }
        }

        isSaving = true;

        try
        {
            model.FakturaPozycje = pozycjeList;
            model.Kwota = SumaBrutto;

            InvoiceXmlConverter xmlConverter = new InvoiceXmlConverter();
            string? xml = null;
            var nabywca = new FakturaPodmiot
            {
                Guid = Guid.NewGuid(),
                Faktura_Guid = model.Guid,
                Faktura_Numer = model.Faktura_Numer,
                Nazwa = model.Nabywca_Nazwa,
                NIP = model.Nabywca_NIP,
                Ulica = model.Nabywca_Ulica,
                Numer_Domu = model.Nabywca_UlicaNumer,
                Kod_Pocztowy = model.Nabywca_KodPocztowy,
                Miejscowosc = model.Nabywca_Miejscowosc,
                Kod_Kraju = "PL",
                Typ_Na_Fa = 2,
                is_Deleted = false,
                Timestamp = DateTime.Now
            };

            FakturaPodmiot? odbiorca = null;
            if (model.Nabywca_NIP != model.Odbiorca_NIP)
            {
                odbiorca = new FakturaPodmiot
                {
                    Guid = Guid.NewGuid(),
                    Faktura_Guid = model.Guid,
                    Faktura_Numer = model.Faktura_Numer,
                    Nazwa = model.Odbiorca_Nazwa,
                    NIP = model.Odbiorca_NIP,
                    Ulica = model.Odbiorca_Ulica,
                    Numer_Domu = model.Odbiorca_UlicaNumer,
                    Kod_Pocztowy = model.Odbiorca_KodPocztowy,
                    Miejscowosc = model.Odbiorca_Miejscowosc,
                    Kod_Kraju = "PL",
                    Typ_Na_Fa = 3,
                    is_Deleted = false,
                    Timestamp = DateTime.Now
                };
            }

            if (CorrectedInvoice != null)
            {
                var CorrectedNabywca = new FakturaPodmiot
                {
                    Guid = Guid.NewGuid(),
                    Faktura_Guid = CorrectedInvoice.Guid,
                    Faktura_Numer = CorrectedInvoice.Faktura_Numer,
                    Nazwa = CorrectedInvoice.Nabywca_Nazwa,
                    NIP = CorrectedInvoice.Nabywca_NIP,
                    Ulica = CorrectedInvoice.Nabywca_Ulica,
                    Numer_Domu = CorrectedInvoice.Nabywca_UlicaNumer,
                    Kod_Pocztowy = CorrectedInvoice.Nabywca_KodPocztowy,
                    Miejscowosc = CorrectedInvoice.Nabywca_Miejscowosc,
                    Kod_Kraju = "PL",
                    Typ_Na_Fa = 2,
                    is_Deleted = false,
                    Timestamp = DateTime.Now
                };

                FakturaPodmiot? CorrectedOdbiorca = null;
                if (CorrectedInvoice.Nabywca_NIP != CorrectedInvoice.Odbiorca_NIP)
                {
                    CorrectedOdbiorca = new FakturaPodmiot
                    {
                        Guid = Guid.NewGuid(),
                        Faktura_Guid = CorrectedInvoice.Guid,
                        Faktura_Numer = CorrectedInvoice.Faktura_Numer,
                        Nazwa = CorrectedInvoice.Odbiorca_Nazwa,
                        NIP = CorrectedInvoice.Odbiorca_NIP,
                        Ulica = CorrectedInvoice.Odbiorca_Ulica,
                        Numer_Domu = CorrectedInvoice.Odbiorca_UlicaNumer,
                        Kod_Pocztowy = CorrectedInvoice.Odbiorca_KodPocztowy,
                        Miejscowosc = CorrectedInvoice.Odbiorca_Miejscowosc,
                        Kod_Kraju = "PL",
                        Typ_Na_Fa = 3,
                        is_Deleted = false,
                        Timestamp = DateTime.Now
                    };
                }

                using var context = await DbContextFactory.CreateDbContextAsync();
                var numerKsef = context.KsefFaktury.FirstOrDefault(e => e.Faktura_Guid == CorrectedInvoice.Guid)?.Resp_ksefNumber;
                xml = xmlConverter.getCorrectionXml(
                    numerKsef,
                    CorrectedInvoice, model,
                    ConfigurationService.ConfigurationData,
                    CorrectedNabywca, nabywca,
                    CorrectedOdbiorca, odbiorca);
            }
            else
            {
                xml = xmlConverter.getInvoiceXml(model, ConfigurationService.ConfigurationData, nabywca, odbiorca);
            }

            ApiResponseDetails? apiResult = null;
            bool useMock = Configuration.GetValue<bool>("KsefSettings:UseMockApi");

            if (useMock)
            {
                apiResult = new ApiResponseDetails
                {
                    IntegrationCode = IntegrationMessageEnum.Operacja_powiodla_sie,
                    SessionReferenceNumber = "SESSION-TEST-2026-MOCK",
                    KsefCode = (System.Net.HttpStatusCode)200,
                    SingleInvoice = new()
                    {
                        AcquisitionDate = DateTime.Now,
                        InvoicingDate = DateTime.Now,
                        PermanentStorageDate = DateTime.Now,
                        InvoiceFileName = $"{model.Faktura_Numer.Replace("/", "_")}.xml",
                        InvoiceHash = "MOCK_HASH_1234567890ABCDEF",
                        InvoiceNumber = model.Faktura_Numer,
                        KsefNumber = $"1234567890-20260813-MOCK-{Guid.NewGuid().ToString().Substring(0, 8).ToUpper()}",
                        ReferenceNumber = $"REF-{Guid.NewGuid().ToString().Substring(0, 10).ToUpper()}",
                        qrInvoiceUrl = "https://ksef-test.mf.gov.pl/web/verify/mock-qr-code",
                        UpoDownloadUrl = new Uri("https://ksef-test.mf.gov.pl/web/upo/mock"),
                        UpoDownloadUrlExpirationDate = DateTime.Now.AddDays(7),
                        Status = new() { Code = 200, Description = "Przyjęto w trybie offline/mock" }
                    }
                };

                await LoadingService.WrapWithDelayAsync(async () =>
                {
                    await Task.Delay(1000);
                }, 1000, "Symulacja rejestracji i generowania KSeF (Tryb Offline)...");
            }
            else
            {
                await LoadingService.WrapWithDelayAsync(async () =>
                {
                    apiResult = await KsefApiIntegrationHelper.PostXmlAsync(ConfigurationService.ConfigurationData.Sprzedawca_NIP, xml);
                }, 2000, "Trwa przetwarzanie i wysyłka dokumentu do systemu KSeF...");
            }

            if (!string.IsNullOrEmpty(xml) && xml.StartsWith("<?xml"))
            {
                int endOfDeclaration = xml.IndexOf("?>");
                if (endOfDeclaration != -1)
                {
                    xml = xml.Substring(endOfDeclaration + 2).Trim();
                }
            }

            bool success = await FakturaService.AddInvoiceAsync(model, apiResult, xml);

            if (success)
            {
                await ConfigurationService.IncrementInvoiceNumberAsync(CorrectedInvoice != null);

                string msg = CorrectedInvoice != null ? $"Wystawiono i wysłano korektę {model.Faktura_Numer}." : $"Wystawiono i wysłano fakturę {model.Faktura_Numer}.";
                await PreferencesService.NotifyAsync(NotificationSeverity.Success, "KSeF", msg);
                DialogService.Close(true);
            }
            else
            {
                await PreferencesService.NotifyAsync(NotificationSeverity.Error, "Błąd", "Nie udało się zapisać dokumentu w bazie.");
            }
        }
        catch (Exception ex)
        {
            await PreferencesService.NotifyAsync(NotificationSeverity.Error, "Błąd", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }
}