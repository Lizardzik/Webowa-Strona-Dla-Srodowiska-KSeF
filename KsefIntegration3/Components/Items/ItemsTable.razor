<FilterCard Title="Filtruj bazę cennika">
    <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenColumn Size="12" SizeMD="8">
            <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Szukaj pozycji</RadzenText>
            <RadzenTextBox Placeholder="Wpisz nazwę pozycji..."
                           Value="@searchTerm"
                           @oninput="@OnItemSearchInput"
                           Style="width: 100%;" />
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="4">
            <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-mb-1">Stawka VAT</RadzenText>
            <RadzenDropDown TValue="string" @bind-Value="@selectedVat" Data="@vatOptions" Style="width: 100%;" />
        </RadzenColumn>
    </RadzenRow>
</FilterCard>

<RadzenCard Class="rz-p-4">
    <RadzenDataGrid Data="@FilteredItems" TItem="Towary" AllowSorting="true" AllowPaging="true" PageSize="@pageSize" Class="rz-font-size-md">
        <EmptyTemplate>
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Class="rz-p-5" Gap="0.75rem">
                <RadzenIcon Icon="search_off" Style="font-size: 3rem; color: var(--rz-text-color-secondary); opacity: 0.6;" />
                <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-m-0 rz-font-weight-bold">
                    Brak danych do wyświetlenia
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary rz-m-0">
                    Nie znaleziono pozycji spełniających wybrane kryteria lub lista jest pusta.
                </RadzenText>
            </RadzenStack>
        </EmptyTemplate>
        <Columns>
            <!-- 1. NAZWA POZYCJI -->
            <RadzenDataGridColumn Property="Nazwa" Title="Nazwa">
                <Template Context="item">
                    <RadzenStack Gap="0.1rem">
                        <strong>@item.Nazwa</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Kod_PKWIU))
                        {
                            <span style="font-size: 0.75rem; color: var(--rz-text-color-secondary);">
                                PKWiU @item.Kod_PKWIU
                            </span>
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>

            <!-- 2. JEDNOSTKA MIARY -->
            <RadzenDataGridColumn Property="Jednostka_Miary" Title="Jednostka" Width="100px" TextAlign="TextAlign.Center">
                <Template Context="item">
                    <span style="font-size: 0.85rem; color: var(--rz-text-color-secondary);">
                        @(string.IsNullOrEmpty(item.Jednostka_Miary) ? "szt." : item.Jednostka_Miary)
                    </span>
                </Template>
            </RadzenDataGridColumn>

            <!-- 3. STAWKA VAT -->
            <RadzenDataGridColumn Property="Stawka_VAT" Title="VAT" Width="90px" TextAlign="TextAlign.Center">
                <Template Context="item">
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@(item.Stawka_VAT.HasValue ? $"{item.Stawka_VAT}%" : "zw.")" IsPill="true" />
                </Template>
            </RadzenDataGridColumn>

            <!-- 4. CENA NETTO -->
            <RadzenDataGridColumn Property="Cena_Netto" Title="Cena netto" Width="130px" TextAlign="TextAlign.Right">
                <Template Context="item">
                    @FormatPLN(item.Cena_Netto)
                </Template>
            </RadzenDataGridColumn>

            <!-- 5. CENA BRUTTO -->
            <RadzenDataGridColumn Property="Cena_Brutto" Title="Cena brutto" Width="130px" TextAlign="TextAlign.Right">
                <Template Context="item">
                    <strong>@FormatPLN(item.Cena_Brutto)</strong>
                </Template>
            </RadzenDataGridColumn>

            <!-- 6. AKCJE -->
            <RadzenDataGridColumn TItem="Towary" Title="Akcje" Width="140px" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="item">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                        <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => OpenViewModal(item))" Title="Szczegóły" />
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => OpenEditModal(item))" Title="Edycja" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(() => HandleDelete(item))" Title="Usuń" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Class="rz-mt-2">
        <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-text-secondary">
            Wyświetlanie <strong>@pageSize</strong> wierszy na stronę
        </RadzenText>
    </RadzenStack>
</RadzenCard>

@code {
    private int pageSize;
    private bool isSettingsLoaded = false;
    private static bool isItemsLoaded = false;

    private List<Towary> itemList = new();

    private string searchTerm = string.Empty;
    private string selectedVat = "Wszystkie";
    private List<string> vatOptions = new() { "Wszystkie", "23%", "8%", "5%", "0%", "zwolniony" };

    private System.Timers.Timer? itemSearchTimer;

    private void OnItemSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;

        itemSearchTimer?.Stop();
        itemSearchTimer?.Dispose();

        itemSearchTimer = new System.Timers.Timer(350);
        itemSearchTimer.AutoReset = false;
        itemSearchTimer.Elapsed += async (s, e) =>
        {
            await InvokeAsync(StateHasChanged);
        };
        itemSearchTimer.Start();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await PreferencesService.GetSettingsAsync();
            if (settings != null && settings.DefaultPageSize > 0)
            {
                pageSize = settings.DefaultPageSize;
                isSettingsLoaded = true;
            }
        }
        catch
        {
        }

        await RefreshTableAsync();
    }

    public async Task RefreshTableAsync()
    {
        if (!isItemsLoaded)
        {
            LoadingService.Show("Pobieranie bazy cennika...");
        }

        try
        {
            itemList = await TowaryService.GetDictionaryItemsAsync();
            if (!isItemsLoaded)
            {
                await Task.Delay(500);
            }
        }
        finally
        {
            if (!isItemsLoaded)
            {
                LoadingService.Hide();
                isItemsLoaded = true;
            }
        }

        StateHasChanged();
    }

    private IEnumerable<Towary> FilteredItems
    {
        get
        {
            var query = itemList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(i => !string.IsNullOrEmpty(i.Nazwa) && i.Nazwa.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedVat != "Wszystkie")
            {
                if (selectedVat == "zwolniony")
                {
                    query = query.Where(i => !i.Stawka_VAT.HasValue);
                }
                else if (int.TryParse(selectedVat.Replace("%", ""), out int vatVal))
                {
                    query = query.Where(i => i.Stawka_VAT == vatVal);
                }
            }

            return query;
        }
    }

    private async Task OpenViewModal(Towary item)
    {
        await DialogService.OpenAsync<ItemDetailsDialog>(
            "Szczegóły pozycji cennikowej",
            new Dictionary<string, object> { { "Item", item } },
            new DialogOptions { Width = "520px" }
        );
    }

    private async Task OpenEditModal(Towary item)
    {
        var result = await DialogService.OpenAsync<ItemFormDialog>(
            "Edycja pozycji",
            new Dictionary<string, object> { { "ItemToEdit", item } },
            new DialogOptions { Width = "500px" }
        );

        if (result == true)
        {
            await RefreshTableAsync();
        }
    }

    private async Task HandleDelete(Towary item)
    {
        bool? confirm = await DialogService.Confirm(
            $"Czy na pewno chcesz usunąć pozycję '{item.Nazwa}' z cennika?",
            "Usuwanie pozycji",
            new ConfirmOptions { OkButtonText = "Tak, usuń", CancelButtonText = "Anuluj" }
        );

        if (confirm == true)
        {
            LoadingService.Show($"Usuwanie pozycji {item.Nazwa}...");
            try
            {
                await TowaryService.DeleteDictionaryItemAsync(item.Id);
            }
            finally
            {
                LoadingService.Hide();
            }

            await PreferencesService.NotifyAsync(NotificationSeverity.Info, "Usunięto", "Pozycja została usunięta ze słownika.");
            await RefreshTableAsync();
        }
    }

    private string FormatPLN(decimal? amount) => amount.HasValue ? $"{amount.Value:N2}\u00A0zł" : "0,00\u00A0zł";
}